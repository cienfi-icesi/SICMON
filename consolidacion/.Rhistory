## con un solo token cacheado, googledrive lo toma solo sin pedir nada
drive_auth(cache = CARPETA_CACHE_DRIVE, email = T)
##============================================================================##
# 00_conectar_drive.R  —  Descarga de Excel desde Google Drive
#------------------------------------------------------------------------------#
# Primer paso de cada corrida: baja a CARPETA_INGESTA (carpeta local) los
# archivos que haya en la carpeta de Google Drive "Registro_afectados_sismo" /
# SUBCARPETA_DRIVE. De ahi en adelante, 01_ingest.R no sabe ni le importa que
# el origen sea Google Drive: sigue leyendo la misma carpeta local de siempre,
# con su propia deteccion de cambios por hash.
#
# Autenticacion: OAuth de usuario, EN NINGUN MOMENTO una credencial de Google
# pasa por este script ni por el repositorio. La primera vez, cada persona
# corre esto de forma interactiva (ver README, "Conexion a Google Drive"): se
# abre el navegador, inicia sesion con su propia cuenta y autoriza el acceso.
# El token queda cacheado en CARPETA_CACHE_DRIVE (fuera de git, la cachea la
# libreria googledrive con su propio nombre de archivo) y de ahi en adelante
# las corridas automaticas lo reutilizan sin pedir nada.
#
# Si no hay token cacheado, o Drive no responde, este paso se salta con un
# aviso en el log: el resto del pipeline sigue con lo que ya haya en
# CARPETA_INGESTA. Un problema de conectividad no debe tumbar la corrida.
##============================================================================##
## configuracion inicial
rm(list = ls())
source("config/packages.R")
source("config/parameters.R")   # CONECTAR_DRIVE, ID_CARPETA_DRIVE, SUBCARPETA_DRIVE, CARPETA_CACHE_DRIVE, CARPETA_INGESTA
source("config/functions.R")    # log_msg
if (!CONECTAR_DRIVE) {
log_msg("drive: conexion desactivada (CONECTAR_DRIVE = FALSE); se omite")
quit(status = 0)
}
dir.create(CARPETA_INGESTA, showWarnings = F, recursive = T)
dir.create(CARPETA_CACHE_DRIVE, showWarnings = F, recursive = T)
##============================================================================##
##=== 1. Autenticacion (no interactiva; usa el token ya cacheado)          ===##
##============================================================================##
resultado <- tryCatch({
hay_token <- length(list.files(CARPETA_CACHE_DRIVE, pattern = "\\.rds$")) > 0
if (!hay_token) {
stop(sprintf(paste("no hay un token guardado en %s.",
"Corra este script una vez de forma interactiva para autorizar el acceso",
"(vea el README, seccion \"Conexion a Google Drive\")."),
CARPETA_CACHE_DRIVE))
}
## con un solo token cacheado, googledrive lo toma solo sin pedir nada
drive_auth(cache = CARPETA_CACHE_DRIVE, email = T)
##============================================================================##
##=== 2. Ubicar la subcarpeta y listar los Excel                           ===##
##============================================================================##
subcarpeta <- drive_ls(as_id(ID_CARPETA_DRIVE), pattern = SUBCARPETA_DRIVE, type = "folder")
if (nrow(subcarpeta) == 0) {
stop(sprintf("no se encontro la subcarpeta '%s' dentro de la carpeta de Drive", SUBCARPETA_DRIVE))
}
remotos <- drive_ls(subcarpeta[1, ]) %>%
filter(grepl("\\.(xlsx|xls|csv)$", name, ignore.case = T))
log_msg(sprintf("drive: %d archivo(s) en '%s' de Google Drive", nrow(remotos), SUBCARPETA_DRIVE))
##============================================================================##
##=== 3. Descargar solo lo nuevo o modificado                              ===##
##============================================================================##
n_descargados <- 0
for (i in seq_len(nrow(remotos))) {
remoto      <- remotos[i, ]
destino     <- file.path(CARPETA_INGESTA, remoto$name)
modificado  <- remoto$drive_resource[[1]]$modifiedTime
## se descarga si el archivo no existe localmente o si Drive reporta una
## version mas reciente que la que hay en disco; la deduplicacion fina
## por contenido (hash) la hace 01_ingest.R sobre lo ya descargado
hace_falta <- !file.exists(destino) ||
as.POSIXct(modificado, format = "%Y-%m-%dT%H:%M:%OSZ", tz = "UTC") > file.mtime(destino)
if (hace_falta) {
drive_download(remoto, path = destino, overwrite = T)
n_descargados <- n_descargados + 1
}
}
log_msg(sprintf("drive: %d archivo(s) descargado(s), %d sin cambios",
n_descargados, nrow(remotos) - n_descargados))
"ok"
}, error = function(e) {
log_msg(sprintf("drive: %s — se omite este paso y se sigue con lo que ya hay en %s",
conditionMessage(e), CARPETA_INGESTA))
"omitido"
})
source("config/packages.R")
source("config/parameters.R")
googledrive::drive_auth(cache = CARPETA_CACHE_DRIVE, email = TRUE)
